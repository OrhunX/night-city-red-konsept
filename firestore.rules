rules_version = '2';
// Night City Masası: her oda rooms/<KOD> altında. Odayı kuran GM'dir (gms listesi).
// GM'ye özel koleksiyonlar: gizli tokenler, NPC sayfaları, gizli DV'ler, kayıtlar, gizli zarlar, değişiklik kayıtları.
// Karakter sayfaları: GM onaylayıp kilitledikten sonra oyuncu STAT, beceri, ekipman, rol ve IP alanlarını değiştiremez.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomData(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function isGM(code) { return signedIn() && request.auth.uid in roomData(code).gms; }
    function gmOnly(col) { return col in ['hidden', 'npcs', 'gmsecret', 'saves', 'savep', 'secret', 'clog']; }
    function special(col) { return col in ['gm', 'members', 'chars', 'clog', 'secret']; }
    function locked() { return resource.data.get('locked', false) == true; }
    function protectedKeys() { return ['stats', 'skills', 'weapons', 'cyber', 'armor', 'rank', 'role', 'fieldExp', 'pharma', 'ip', 'ipLog', 'locked', 'owner', 'kind']; }

    // kişisel karakter klasörü: sadece sahibi
    match /users/{uid}/chars/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{code} {
      allow get, list: if signedIn();
      allow create: if signedIn() && request.resource.data.gms == [request.auth.uid];
      allow update, delete: if isGM(code);

      // herkes kendi üyelik kaydını yazar; GM masayı silerken hepsini temizler
      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && (request.auth.uid == uid || isGM(code));
      }
      // gizli zarlar: atan oyuncu kendininkini, GM hepsini görür
      match /secret/{uid} {
        allow read, write: if isGM(code) || (signedIn() && request.auth.uid == uid);
      }
      // fısıltılar: alıcının kutusu; gönderen kendi adına yazar
      match /wsp/{uid}/m/{id} {
        allow read: if isGM(code) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.resource.data.by == request.auth.uid;
        allow delete: if isGM(code) || (signedIn() && request.auth.uid == uid);
      }
      // değişiklik kaydı: herkes ekler, sadece GM okur
      match /clog/{id} {
        allow create: if signedIn();
        allow read, update, delete: if isGM(code);
      }
      // karakter sayfaları
      match /chars/{cid} {
        allow read: if signedIn();
        allow create: if isGM(code) || (signedIn() && request.resource.data.owner == request.auth.uid && request.resource.data.get('locked', false) != true);
        allow delete: if isGM(code) || (signedIn() && resource.data.owner == request.auth.uid && !locked());
        allow update: if isGM(code) || (signedIn() && resource.data.owner == request.auth.uid
          && request.resource.data.get('locked', false) == resource.data.get('locked', false)
          && request.resource.data.get('owner', '') == resource.data.get('owner', '')
          && (!locked() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedKeys())));
      }
      match /{col}/{doc} {
        allow read: if signedIn() && !special(col) && (!gmOnly(col) || isGM(code));
        allow read: if signedIn() && col == 'gm';
        allow write: if signedIn() && !special(col) && (!gmOnly(col) || isGM(code));
        allow write: if col == 'gm' && isGM(code);
      }
    }
  }
}
